# Copie ce fichier en .env et remplis les valeurs

# Ta clé API PandaScore (récupérée sur pandascore.co)
PANDASCORE_TOKEN=YOUR_PANDASCORE_TOKEN_HERE

# Port du serveur Express
PORT=3001

# URL Redis (optionnel — si absent, le cache est en mémoire)
# Railway fournit cette variable automatiquement si tu ajoutes un service Redis
REDIS_URL=redis://localhost:6379

# URL du frontend (pour le CORS)
FRONTEND_URL=http://localhost:5173
